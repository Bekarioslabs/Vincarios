{
  "name": "vincarios",
  "version": "0.1.0-beta.1",
  "private": true,
  "description": "Local-first Markdown assistant with visible, reviewable AI workflows.",
  "main": "src/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "model:provision": "node scripts/provision-embedding-model.js",
    "model:verify": "node scripts/verify-embedding-model.js",
    "build:win": "npm run model:verify && electron-builder --win portable",
    "check": "node scripts/check-js.js",
    "audit:security": "npm audit --omit=dev --audit-level=high && node scripts/audit-dependencies.js",
    "licenses:generate": "node scripts/check-licenses.js --write",
    "licenses:check": "node scripts/check-licenses.js",
    "test": "npm run check && node --test tests/*.test.js"
  },
  "keywords": [
    "obsidian",
    "markdown",
    "local-first",
    "vault",
    "assistant"
  ],
  "author": "Bekarios Labs",
  "license": "GPL-3.0-only",
  "build": {
    "appId": "com.bekarioslabs.vincarios",
    "productName": "vincarios",
    "icon": "src/renderer/assets/brand/vincarios-icon.png",
    "asar": true,
    "asarUnpack": [
      "node_modules/onnxruntime-node/**"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "index.html",
      "package.json",
      "third_party/**/*",
      "!**/.vincarios/**",
      "!dev-vault/**",
      "!docs/**",
      "!tests/**"
    ],
    "extraResources": [
      {
        "from": ".vincarios/models/embeddings",
        "to": "vincarios-models/embeddings",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "licenses",
        "to": "licenses",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "vincarios-${version}-portable.${ext}"
    },
    "portable": {
      "requestExecutionLevel": "user"
    }
  },
  "devDependencies": {
    "electron": "42.5.1",
    "electron-builder": "26.15.7"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "markdown-it": "14.3.0",
    "yaml": "2.9.0"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "sharp": "0.35.3"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "onnxruntime-node@1.24.3": true,
    "protobufjs": false
  }
}
