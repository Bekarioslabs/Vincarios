{
  "name": "vincarios",
  "version": "0.1.0-beta.1",
  "private": true,
  "description": "Local-first Markdown assistant with visible, reviewable AI workflows.",
  "main": "src/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "model:provision": "node scripts/provision-embedding-model.js",
    "model:verify": "node scripts/verify-embedding-model.js",
    "build:win": "npm run model:verify && electron-builder --win portable",
    "check": "node scripts/check-js.js",
    "audit:security": "npm audit --json | node scripts/audit-dependencies.js",
    "licenses:generate": "node scripts/check-licenses.js --write",
    "licenses:check": "node scripts/check-licenses.js",
    "test": "npm run check && node --test tests/*.test.js"
  },
  "keywords": [
    "obsidian",
    "markdown",
    "local-first",
    "vault",
    "assistant"
  ],
  "author": "Bekarios Labs",
  "license": "GPL-3.0-only",
  "build": {
    "appId": "com.bekarioslabs.vincarios",
    "productName": "vincarios",
    "icon": "src/renderer/assets/brand/vincarios-icon.ico",
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "asarUnpack": [
      "node_modules/onnxruntime-node/**"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "index.html",
      "package.json",
      "LICENSE",
      "third_party/**/*",
      "!**/.vincarios/**",
      "!dev-vault/**",
      "!docs/**",
      "!tests/**"
    ],
    "extraResources": [
      {
        "from": ".vincarios/models/embeddings",
        "to": "vincarios-models/embeddings",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "licenses",
        "to": "licenses",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "vincarios-${version}-portable.${ext}"
    },
    "portable": {
      "requestExecutionLevel": "user"
    }
  },
  "devDependencies": {
    "electron": "44.10.0",
    "electron-builder": "26.17.0"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "markdown-it": "14.3.3",
    "yaml": "2.9.1"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15",
    "adm-zip": "0.6.1",
    "sharp": "0.35.5",
    "fast-uri": "3.1.9",
    "http-cache-semantics": "4.3.0",
    "js-yaml": "4.3.2",
    "undici@7": "7.30.1",
    "undici@6": "6.29.1",
    "minimatch@3": {
      "brace-expansion": "1.1.21"
    },
    "minimatch@5": {
      "brace-expansion": "2.1.7"
    },
    "minimatch@9": {
      "brace-expansion": "2.1.7"
    },
    "minimatch@10": {
      "brace-expansion": "5.0.12"
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "onnxruntime-node@1.30.0": true,
    "protobufjs": false
  }
}
